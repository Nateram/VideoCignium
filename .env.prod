# Archivo de configuración para producción
# Copia este archivo como .env.prod y configura tus valores

# Configuración Flask
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=false

# Configuración del servidor
HOST=0.0.0.0
PORT=8000

# Configuración de procesamiento (reducido para servidor)
MAX_WORKERS=4
UPLOAD_FOLDER=/app/static/uploads

# Configuración de logging
LOG_LEVEL=WARNING

# Configuración de base de datos
DATABASE_URL=sqlite:///app/data/app.db

# Configuración de modelo YOLO
YOLO_MODEL_PATH=/app/yolov10n.pt

# Configuración de seguridad (IMPORTANTE)
SECRET_KEY=tu_clave_secreta_muy_segura_aqui
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# Configuración de CORS (ajusta para tu dominio)
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com