{
  "name": "detector-movimiento",
  "version": "1.0.0",
  "description": "Detector de Movimiento - Aplicación de Escritorio",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "dev": "electron . --dev"
  },
  "author": "Detector de Movimiento",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "build": {
    "appId": "com.detector.movimiento",
    "productName": "Detector de Movimiento",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "static/**/*",
      "templates/**/*",
      "*.py",
      "*.json",
      "*.pt",
      "ffmpeg-2025-09-28-git-0fdb5829e3-essentials_build/**/*",
      "!node_modules",
      "!logs",
      "!__pycache__",
      "!*.pyc",
      "!.git"
    ],
    "extraResources": [
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
